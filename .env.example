# Copie para .env (não versionado)
DATABASE_URL="mysql://root:root@localhost:3307/quiz"
TEST_DATABASE_URL="mysql://root:root@localhost:3307/quiz_test"

API_PORT=4000
# Origem pública do app (mesmo domínio do frontend via proxy reverso)
APP_ORIGIN="http://localhost:3000"
API_ORIGIN="http://localhost:4000"

# Login Google (OAuth client ID do tipo Web)
GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Primeiros administradores (e-mails separados por vírgula)
ADMIN_EMAILS="verediane.designer@gmail.com"

# Diretório de uploads (fora do repositório em produção)
UPLOAD_DIR="./uploads"
SESSION_TTL_DAYS=14

# Apenas desenvolvimento local (ignorado em produção)
DEV_AUTH_BYPASS=true
NEXT_PUBLIC_DEV_AUTH=true

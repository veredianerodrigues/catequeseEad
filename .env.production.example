# Modelo para PRODUÇÃO (sabercatequese.online). Copie os valores para o painel/ambiente do servidor.
# NÃO coloque senhas reais neste arquivo nem o versione.

NODE_ENV=production

# --- API (subdomínio api.sabercatequese.online) ---
API_PORT=4000
# Origem do site (checagem de Origin/CSRF). Sem barra no final.
APP_ORIGIN=https://sabercatequese.online
DATABASE_URL="mysql://USUARIO:SENHA@127.0.0.1:3306/NOME_DO_BANCO"
GOOGLE_CLIENT_ID="<Client ID do Google>"
ADMIN_EMAILS="verediane.designer@gmail.com"
# Pasta persistente e FORA do repositório (imagens e PDFs dos enunciados). Faça backup.
UPLOAD_DIR=/var/quiz/uploads
SESSION_TTL_DAYS=14
TRUST_PROXY=true

# --- Site (sabercatequese.online) — estas duas são lidas NO BUILD (pnpm build) ---
API_ORIGIN=https://api.sabercatequese.online
NEXT_PUBLIC_GOOGLE_CLIENT_ID="<mesmo Client ID do Google>"

# NUNCA definir em produção: DEV_AUTH_BYPASS, NEXT_PUBLIC_DEV_AUTH
